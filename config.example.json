{
  "opencode": {
    "hostname": "127.0.0.1",
    "projectDirectory": "/home/admin/workspace",
    "autoApprovePermissions": true
  },
  "channels": {
    "discord": {
      "enabled": true,
      "token": "YOUR_DISCORD_BOT_TOKEN",
      "allowBots": false,
      "groupPolicy": "allowlist",
      "guilds": {
        "YOUR_GUILD_ID": {
          "requireMention": false,
          "users": ["YOUR_USER_ID"],
          "channels": {
            "YOUR_CHANNEL_ID_1": {
              "allow": true
            },
            "YOUR_CHANNEL_ID_2": {
              "allow": true,
              "systemPrompt": "你是一位记录员,工作目录:${WORKSPACE_DIR},工作准则skill:${SKILL_PATH}"
            },
            "YOUR_CHANNEL_ID_3": {
              "allow": true
            }
          }
        }
      }
    }
  }
}
